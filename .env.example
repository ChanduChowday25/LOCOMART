# ==================================================
# LOCOMART — Environment Configuration Template
# ==================================================
# Copy this file and fill in real values.
# NEVER commit files with real secrets.
# For backend: copy to backend/.env
# For frontend: copy to frontend/.env
# ==================================================

# --------------------------------------------------
# FastAPI / Backend
# --------------------------------------------------

APP_ENV=development
APP_DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret-key-for-jwt-signing

# InsForge project settings
INSFORGE_URL=https://5xekk2s5.ap-southeast.insforge.app
INSFORGE_API_KEY=<your-insforge-admin-api-key>
INSFORGE_ANON_KEY=<your-insforge-anon-key>

# Database (used when deployed on InsForge infrastructure — optional for local dev)
# Local dev uses the InsForge HTTP API for DB operations.
# DATABASE_URL=postgresql+asyncpg://project_admin:<password>@<host>:5432/insforge
# DATABASE_SYNC_URL=postgresql://project_admin:<password>@<host>:5432/insforge

# CORS — allowed origins for FastAPI (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Stripe Test Mode (M6)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# --------------------------------------------------
# React / Frontend
# --------------------------------------------------

VITE_API_URL=http://localhost:8000
VITE_INSFORGE_URL=https://5xekk2s5.ap-southeast.insforge.app
VITE_INSFORGE_ANON_KEY=<your-insforge-anon-key>
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
