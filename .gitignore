# ==================================================
# LOCOMART — Local Grocery Assistance Platform
# .gitignore
# ==================================================

# ---- Environment / Secrets (NEVER commit these) ----
.env
.env.local
.env.*.local
.env.*
*.env
backend/.env
backend/.env.compute
frontend/.env
frontend/.env.local

# ---- Python / Backend ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# Virtual environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Alembic runtime files (keep alembic.ini & versions/)
# alembic/versions/*.py are committed

# ---- Node / Frontend ----
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm
.yarn-integrity
*.tsbuildinfo
frontend/.tsbuildinfo
scratch_test_*.mjs
frontend/scratch_test_*.mjs

# ---- IDE / OS ----
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/

# ---- Test / Coverage ----
.coverage
htmlcov/
.pytest_cache/
test_results.txt
backend/test_results.txt

# ---- Misc ----
*.bak
*.tmp

# InsForge & AI agent skills
.insforge
.agent
.agents
.augment
.claude
.cline
.github/copilot*
.kilocode
